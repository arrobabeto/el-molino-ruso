---
import type { Locale } from "~/config/locales"

interface Props {
  locale: Locale
}

const { locale: _locale } = Astro.props

const navLinks = [
  { label: "Inicio", href: "/", active: true },
  { label: "Menú", href: "#menu" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Contacto", href: "#ubicacion" },
]

const whatsappUrl =
  "https://wa.me/524446007007?text=Hola%20El%20Molino%20Ruso%2C%20me%20gustar%C3%ADa%20hacer%20un%20pedido."
---

<header
  class="molino-site-header molino-site-header-hero sticky top-0 z-50"
  data-site-header
>
  <nav
    class="container-wide flex h-full items-center justify-between gap-6"
    aria-label="Principal"
  >
    <a href="/" class="flex shrink-0 items-center">
      <img
        src="/images/logo.avif"
        alt="El Molino Ruso"
        class="size-16 rounded-full object-cover"
        width="64"
        height="64"
      />
    </a>

    <ul class="hidden items-center gap-8 text-sm lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              class:list={[
                "molino-nav-link font-medium transition-colors",
                link.active && "molino-nav-link-active font-semibold",
              ]}
              href={link.href}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={whatsappUrl}
      class="btn-nav-whatsapp shrink-0 text-[13px]"
      target="_blank"
      rel="noopener"
    >
      Pedir por WhatsApp
    </a>
  </nav>
</header>

<script>
  function initHeaderScroll() {
    const headerEl = document.querySelector("[data-site-header]")
    const trackEl = document.querySelector("[data-hero-track]")
    if (
      !(headerEl instanceof HTMLElement) ||
      !(trackEl instanceof HTMLElement)
    ) {
      return
    }
    const header: HTMLElement = headerEl
    const heroTrack: HTMLElement = trackEl

    function update() {
      const trackRect = heroTrack.getBoundingClientRect()
      const scrollRoom = heroTrack.offsetHeight - window.innerHeight
      const scrolled = Math.min(Math.max(-trackRect.top, 0), scrollRoom)
      const pastHero = scrollRoom > 0 && scrolled >= scrollRoom - 4
      header.classList.toggle("molino-site-header-scrolled", pastHero)
    }

    update()
    window.addEventListener("scroll", update, { passive: true })
    window.addEventListener("resize", update, { passive: true })
  }

  initHeaderScroll()
  document.addEventListener("astro:page-load", initHeaderScroll)
</script>
