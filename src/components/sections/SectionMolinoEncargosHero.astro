---
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  title?: I18nString
  lead?: I18nString
  ctaLabel?: I18nString
  ctaHref?: string
  img?: string
  locale: Locale
}

const {
  title,
  lead,
  ctaLabel,
  ctaHref = "https://wa.me/524446007007",
  img = "/images/encargos.avif",
  locale,
} = Astro.props
---

<section id="encargos" class="molino-section molino-section-dark">
  <div class="container-wide grid items-center gap-10 lg:grid-cols-2">
    <div>
      <h2 class="molino-heading-lg mb-6 text-white">
        {translate(title, locale)}
      </h2>
      <p class="mb-8 text-base leading-relaxed text-white/85">
        {translate(lead, locale)}
      </p>
      <a href={ctaHref} class="btn-primary" target="_blank" rel="noopener">
        {translate(ctaLabel, locale)}
      </a>
    </div>
    <img
      src={img}
      alt=""
      class="w-full rounded-2xl object-cover"
      loading="lazy"
    />
  </div>
</section>
