---
import { translate } from "~/lib/i18n"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  scheduleTitle?: I18nString
  scheduleValue?: I18nString
  promoTitle?: I18nString
  promoValue?: I18nString
  locale: Locale
}

const { scheduleTitle, scheduleValue, promoTitle, promoValue, locale } =
  Astro.props
---

<section
  class="border-molino-cream-border bg-molino-cream-soft border-y py-6 md:py-8"
  data-testid="molino-hours"
  aria-label="Horario y promociones"
>
  <div class="container-wide">
    <div
      class="mx-auto flex max-w-4xl flex-col gap-6 md:flex-row md:items-stretch md:justify-center md:gap-0"
    >
      <div
        class="border-molino-cream-border flex flex-col justify-center text-center md:flex-1 md:border-r md:px-10"
      >
        <p
          class="text-molino-gold mb-1 text-xs font-semibold tracking-[0.18em] uppercase"
        >
          {translate(scheduleTitle, locale)}
        </p>
        <p class="text-molino-ink font-serif text-lg md:text-xl">
          {translate(scheduleValue, locale)}
        </p>
      </div>

      <div
        class="border-molino-cream-border flex flex-col justify-center text-center md:flex-1 md:px-10"
      >
        <p
          class="text-molino-gold mb-1 text-xs font-semibold tracking-[0.18em] uppercase"
        >
          {translate(promoTitle, locale)}
        </p>
        <p class="text-molino-ink font-serif text-lg md:text-xl">
          {translate(promoValue, locale)}
        </p>
      </div>
    </div>
  </div>
</section>
